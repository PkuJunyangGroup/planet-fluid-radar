{
  "name": "planet-fluid-radar-visits",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "triggers": { "crons": ["15 17 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "planet-fluid-radar-visits",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
